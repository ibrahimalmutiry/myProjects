# ============================================================
#  انسخ هذا الملف إلى .env وعدّل القيم
#  cp .env.example .env
#  ملف .env لا يُرفع لـ git أبداً
# ============================================================

# قاعدة البيانات
DB_HOST=localhost
DB_NAME=workflow_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# بيئة التشغيل: production | development
APP_ENV=production

# SMTP (يُقرأ من notification_functions.php)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=نظام الإدارة

# CRON (للاستدعاء عبر HTTP كبديل لـ CLI)
CRON_TOKEN=
