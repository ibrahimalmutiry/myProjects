# ╔══════════════════════════════════════════════════════════════════╗
# ║        نظام إدارة معاملات القطاع المالي — Workflow System        ║
# ║                      ملف الإعدادات  .env                         ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║  1. انسخ هذا الملف:  cp .env.example .env                       ║
# ║  2. ضع الملف خارج public_html — مثلاً: /var/www/.env            ║
# ║  3. لا ترفعه أبداً لـ Git (.gitignore + .htaccess يحمانه)       ║
# ║  4. الملف يُقرأ تلقائياً من config.php                          ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────
#  المسار الصحيح للملف (اختر الأنسب لبيئتك)
#
#    إنتاج (production):
#      /var/www/.env                   ← خارج public_html مباشرة
#      /home/username/.env             ← مجلد المستخدم
#
#    تطوير محلي (XAMPP / Laragon):
#      C:\xampp\htdocs\.env            ← مستوى فوق المشروع
#      ../workflow-system/../.env
#
#  config.php يبحث في هذه المسارات بالترتيب:
#    dirname(__DIR__)/.env  →  dirname(__DIR__,2)/.env  →  __DIR__/../.env
# ─────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════
#  [1] بيئة التشغيل — App Environment
# ══════════════════════════════════════════════════════════════════

APP_ENV=development
# القيم المتاحة:
#   production  → أخطاء مخفية، أمان مُفعَّل، لوغز فقط
#   development → أخطاء تظهر في المتصفح، تخطي بعض فحوصات HTTPS

APP_ORIGIN=https://yourdomain.com
# الدومين الكامل بدون / في النهاية — يُستخدم للـ CORS وإرسال الإيميلات


# ══════════════════════════════════════════════════════════════════
#  [2] قاعدة البيانات — Database
# ══════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_NAME=workflow_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── توليد كلمة مرور قوية ────────────────────────────────────────
#   Linux/Mac:  openssl rand -base64 32
#   Windows:    [System.Web.Security.Membership]::GeneratePassword(32,4)
#
# ── إنشاء مستخدم DB مخصص (لا تستخدم root في الإنتاج!) ──────────
#   CREATE DATABASE workflow_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'workflow_user'@'localhost' IDENTIFIED BY 'كلمة_المرور';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON workflow_db.* TO 'workflow_user'@'localhost';
#   FLUSH PRIVILEGES;


# ══════════════════════════════════════════════════════════════════
#  [3] البريد الإلكتروني SMTP — Email (notification_functions.php)
# ══════════════════════════════════════════════════════════════════

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
# القيم المتاحة: tls | ssl | '' (بدون تشفير — غير موصى به)

SMTP_USER=your@gmail.com
SMTP_PASS=
# Gmail: استخدم App Password (ليس كلمة المرور الرئيسية)
# الحصول عليه: myaccount.google.com → Security → App Passwords

SMTP_FROM_NAME=نظام إدارة المعاملات
# الاسم الظاهر في البريد المرسَل

# ── بديل: Microsoft Exchange / Office 365 ───────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USER=your@company.com
# SMTP_PASS=


# ══════════════════════════════════════════════════════════════════
#  [4] Microsoft Graph API (اختياري — بديل SMTP لـ Exchange)
#      يُقرأ في notification_functions.php
# ══════════════════════════════════════════════════════════════════

MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_EMAIL=
# اتركها فارغة إذا لم تستخدم Microsoft Graph
# للإعداد: portal.azure.com → App Registrations → API Permissions → Mail.Send


# ══════════════════════════════════════════════════════════════════
#  [5] CRON / المهام الدورية
# ══════════════════════════════════════════════════════════════════

CRON_TOKEN=
# رمز سري لحماية نقاط CRON عبر HTTP (بديل CLI crontab)
# توليد: openssl rand -hex 32
# الاستخدام: https://yourdomain.com/cron.php?token=YOUR_TOKEN


# ══════════════════════════════════════════════════════════════════
#  [6] الأمان الإضافي — Extra Security (اختياري)
# ══════════════════════════════════════════════════════════════════

SESSION_LIFETIME=7200
# مدة الجلسة بالثواني — الافتراضي 7200 (ساعتان)

# ─────────────────────────────────────────────────────────────────
#  ✅ قائمة فحص قبل الإنتاج — Pre-Production Checklist
# ─────────────────────────────────────────────────────────────────
#  [ ] APP_ENV=production
#  [ ] DB_USER ≠ root
#  [ ] DB_PASS قوية ومُولَّدة
#  [ ] SMTP_PASS مضبوط
#  [ ] APP_ORIGIN يطابق الدومين الحقيقي
#  [ ] الملف خارج public_html
#  [ ] chmod 600 .env
#  [ ] .gitignore يتضمن .env
# ─────────────────────────────────────────────────────────────────
